# Database (Supabase PostgreSQL)
# Pooler (Transaction mode) — usado pelo app em runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta — usado pelo Prisma Migrate
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Server
PORT=3030
FRONTEND_URL=http://localhost:5000
NODE_ENV=development

# Groq AI
GROQ_API_KEY=your_groq_api_key

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=player2luv
R2_PUBLIC_URL=https://your-public-url.r2.dev

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token

# Webhook signature secret (from MercadoPago panel)
WEBHOOK_SECRET=your_webhook_secret

# Gift Price (in BRL cents — 990 = R$ 9,90)
GIFT_PRICE=990

# App URL (for webhooks — in production, your Vercel backend URL)
APP_URL=http://localhost:3030
